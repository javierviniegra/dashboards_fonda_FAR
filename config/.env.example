# Copy to config/.env (gitignored) and fill in. Never commit the real .env.
# Rule: every secret of this project lives in config/.env and gets a blank
# placeholder line here. Never in code, SQL, docs or git.

# ENV: "dev" uses the *_DEV database variables below and DEBUG=true by default.
ENV=dev
# FUENTES_ENV: where indicator DATA is read from ("prod" or "dev"); defaults to ENV.
# prod = the productive Wansoft and Presupuestos AP databases (read-only
# sessions), even while the app itself runs in dev.
FUENTES_ENV=

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Dev server: python manage.py runserver 8045 (8000 XAMPP, 8010/8020
# Presupuestos AP, 8040-8044 taken by other apps).

# Only in production, behind Apache: /dashboards_fonda/. Blank in dev.
DJANGO_FORCE_SCRIPT_NAME=
# Set to true only once HTTPS is in front of the proxy.
DJANGO_SECURE_COOKIES=false
# Needed once served through the proxy, e.g. http://187.251.203.223:8088
DJANGO_CSRF_TRUSTED_ORIGINS=

# This app's OWN database (users, groups, cache) - PROD (separate DB server)
DASHBOARDS_DB_HOST=
DASHBOARDS_DB_PORT=3306
DASHBOARDS_DB_USER=
DASHBOARDS_DB_PASSWORD=
DASHBOARDS_DB_NAME=
# This app's OWN database - DEV (local XAMPP MariaDB)
DASHBOARDS_DB_HOST_DEV=localhost
DASHBOARDS_DB_PORT_DEV=3306
DASHBOARDS_DB_USER_DEV=
DASHBOARDS_DB_PASSWORD_DEV=
DASHBOARDS_DB_NAME_DEV=dashboards_fonda_dev

# ---------------------------------------------------------------------------
# Indicator DATA sources (READ-ONLY use). Same variable names as Central de
# Reportes, because Central's engine (vendor/central) reads them. In
# production use SELECT-only accounts.
# ---------------------------------------------------------------------------
# Wansoft warehouse - PROD
WANSOFT_DB_HOST=
WANSOFT_DB_USER=
WANSOFT_DB_PASSWORD=
WANSOFT_DB_NAME=
# Wansoft warehouse - DEV
WANSOFT_DB_HOST_DEV=localhost
WANSOFT_DB_USER_DEV=
WANSOFT_DB_PASSWORD_DEV=
WANSOFT_DB_NAME_DEV=

# ControlPresupuestos_AP database - PROD
PRESUPUESTOS_DB_HOST=
PRESUPUESTOS_DB_PORT=3306
PRESUPUESTOS_DB_USER=
PRESUPUESTOS_DB_PASSWORD=
PRESUPUESTOS_DB_NAME=
# ControlPresupuestos_AP database - DEV
PRESUPUESTOS_DB_HOST_DEV=localhost
PRESUPUESTOS_DB_PORT_DEV=3306
PRESUPUESTOS_DB_USER_DEV=
PRESUPUESTOS_DB_PASSWORD_DEV=
PRESUPUESTOS_DB_NAME_DEV=

# Odoo (READ-ONLY use, XML-RPC search/read only)
ODOO_URL=
ODOO_DB_NAME=
ODOO_USER=
ODOO_PASSWORD=

# Central de Reportes' own database (READ-ONLY use): the CEDIS customer -> branch
# mapping (central_clientecedis, cuentas_sucursal) and the INPC (central_inflacion).
# Production: a SELECT-only account on those three tables is preferred.
CENTRAL_DB_HOST=
CENTRAL_DB_PORT=3306
CENTRAL_DB_USER=
CENTRAL_DB_PASSWORD=
CENTRAL_DB_NAME=
CENTRAL_DB_HOST_DEV=
CENTRAL_DB_PORT_DEV=3306
CENTRAL_DB_USER_DEV=
CENTRAL_DB_PASSWORD_DEV=
CENTRAL_DB_NAME_DEV=
